{
  // tsconfig.json
  "compilerOptions": {
    // Filstruktur (valfritt men bra)
    "rootDir": "./src",
    "outDir": "./dist",

    // Miljö
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    // Viktigt för import express from "express"
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Typsäkerhet
    "strict": true,
    "skipLibCheck": true,

    // Övrigt
    "sourceMap": true
  }
}
